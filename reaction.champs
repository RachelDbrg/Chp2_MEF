## These are the reaction terms
# Définition du champ F utilisé dans le terme source :
#scalaire fV1 rV1*V1*(1-(V1/kV1))-((aH1V1*V1)/(1+aH1V1*hH1V1*V1+aH1V2*hH1V2*V2))*H1
#scalaire fV2 rV2*V2*(1-(V2/kV2))-((aH2V2*V2)/(1+aH2V2*hH2V2*V2))*H2
#scalaire fH1 chiH1*epsilonH1*( (aH1V1*eH1V1*V1+aH1V2*eH1V2*V2)/(1+aH1V1*hH1V1*V1+aH1V2*hH1V2*V2) - muH1)*H1 - phiH1 * H1^2 - ( (aPH1*H1)/(1+aPH1*hPH1*H1+aPH2*hPH2*H2+aPH3*hPH3*H3) )*P
#scalaire fH2 chiH2*epsilonH2*( (aH2V2*eH2V2*V2)/(1+aH2V2*hH2V2*V2) - muH2)*H2 - phiH2 * H2^2 - ( (aPH2*H2)/(1+aPH1*hPH1*H1+aPH2*hPH2*H2+aPH3*hPH3*H3) )*P
#scalaire fH3 chiH3*epsilonH3*( (aH3V2*eH3V2*V2)/(1+aH3V2*hH3V2*V2) - muH3)*H3 - phiH3 * H3^2 - ( (aPH3*H3)/(1+aPH1*hPH1*H1+aPH2*hPH2*H2+aPH3*hPH3*H3) )*P
#scalaire fP P*(chiP * ((aPH2*H2 + epsilonH1H2*aPH1*H1 + epsilonH3H2*aPH3*H3)/(1+aPH1*hPH1*H1+aPH2*hPH2*H2+aPH3*hPH3*H3))-mu_P - phi_P - h)

