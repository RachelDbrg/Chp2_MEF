### Expression algébrique pour normaliser le rayon selon la taille du paysage
#scalaire "alg_rayon_perception_C_norm" f(rayon_perception_C,L)=rayon_perception_C/L
#scalaire "alg_rayon_perception_M_norm" f(rayon_perception_M,L)=rayon_perception_M/L
#scalaire "alg_rayon_perception_P_norm" f(rayon_perception_P,L)=rayon_perception_P/L
#scalaire "alg_rayon_perception_D_norm" f(rayon_perception_D,L)=rayon_perception_D/L


### Initialisation du scalaire de perception normalise
scalaire L 1
scalaire rayon_perception_C_norm 1 
scalaire rayon_perception_M_norm 1 
scalaire rayon_perception_P_norm 1 
scalaire rayon_perception_D1_norm 1 


