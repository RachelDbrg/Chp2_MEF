#==========================================================================================================================================================================
#             Simple and cross diffusion model - application to the wolf ungulate system
#==========================================================================================================================================================================



# ================================================= 0. INITIALISATION                                   ===================================================================
# ================================================= 0.1 Definition du paysage a partir du .csv          ===================================================================

# Spécification du champ géométrique à utiliser pour le problème (linéaire ou quadratique).
# Nous prenons ici un champ géométrique linéaire:
champgeolin champgeo


# ----------- NO LONGER NEEDED WHEN RUN WITH PYTHON ----------------

# Le maillage utilise provient d'un .csv converti en maillage (.mail) par le programme:
#/cluster/logiciels/GIREF/GIREF.2024-07-29.AppImage ConversionMaillage "1_10_3.csv" GRILLEBARYCSV 2 Lin carreRachel
#/cluster/logiciels/GIREF/GIREF.2024-07-29.AppImage ConversionMaillage "1_10_3.csv" GRILLESOMMETCSV 2 Lin carreRachel


# Ici on convertit le .csv en .mail et on charge donc:
## les coordonnes x et y normalisees (col 1 et col2)
### a. Raster de types d'habitat (col3)
### b. Raster de heterogeneité (col4)


## Ce code appelle la conversion d'un .csv en entrée vers un .mail, et il cree aussi un cmefpp par colonne supplementaire dans le .csv originel
## Commenté quand on utilise le grand paysage car doit être convertit en binaire
#include conversion_csv_mail.champs

# Si on fait maillage sur sommets:
## on recupere ici chacune des colonnes du .csv
scallin valeurs_paysage "carreRachel.habitat.cmefpp"
scallin valeurs_diversity "carreRachel.diversity.cmefpp"


# Si on fait maillage sur barycentress
#scalconstelem valeurs_paysage "carreRachel.category.cmefpp"

## Ici, on importe les metadonnes liees au .csv du paysage: Vraie longueur et largeur en km (length_landscape)

### !!!!!!!!!! A changer en fonction du paysage !!!!!!!!!!
include metadata_landscape.champs


## Découpe le paysage en binaires en fct du type d'habitat
include decoupe_paysage_binaire.champs





# ================================================= 0.2 Definition du schema d'integration              ===================================================================

# Paramètres qui serviront à créer un schéma d'intégration. Plus il y a de points, et plus la solution est
# exacte. Il faut respecter certains critères lorsqu'on met des points (seulement certaines valeurs)
# fonctionnent dépendamment du type d'élément:
{ ParamSchema
  scalaire ptintgarete               3
  scalaire ptintgface3               3
  scalaire ptintgface4               2
  scalaire ptintgelement1d           3
  scalaire ptintgtriangle            16
  scalaire ptintgquadrangle          2
  #scalaire ptintgtetra               5l
  scalaire ptintgprismetri_legendre  2
  scalaire ptintgprismetri_triangle  3
  scalaire ptintghexa                2
}

# Création d'un schéma d'intégration selon les paramètres du "namespace" ParamSchema
schemaintg schema_intg ParamSchema




# ================================================= 0.3 Definition entite geométriques du domaine  =================================================================
## La creation du maillage n'entraine pas la creation des entités, alors on fait ca nous meme
## En gros, defini un carre de (0,1)^2
include definition_domaine.champs



# ------------------------------------ Obstacle ------------------------------------------------------------------------------------------------------------

## Conditions limites par rapport a une frontiere
## Neumann: impose une valeur a la derivee normale par rapport a l'entite ((ie caracterise le flux))


### Ici on definit les contours des obstacles
# ROAD 1
scalaire                    fct_obstacle_bas_1      if(y=0.3 & x>=0.1 & x<=0.3, 1, 0)
critere_fct_caracteristique obstacle_bas_1          [fct_obstacle_bas_1, 0]
cree_entite_avec_critere    bas_obstacle_1          ENTITE_ARETES_SSC(obstacle_bas_1)

scalaire                    fct_obstacle_haut_1     if(y=0.7 & x>=0.1 & x<=0.3, 1, 0)
critere_fct_caracteristique obstacle_haut_1         [fct_obstacle_haut_1, 0]
cree_entite_avec_critere    haut_obstacle_1         ENTITE_ARETES_SSC(obstacle_haut_1)

scalaire                    fct_obstacle_gauche_1   if(x=0.1 & y>=0.3 & y<=0.7, 1, 0)
critere_fct_caracteristique obstacle_gauche_1       [fct_obstacle_gauche_1, 0]
cree_entite_avec_critere    gauche_obstacle_1       ENTITE_ARETES_SSC(obstacle_gauche_1)

scalaire                    fct_obstacle_droite_1   if(x=0.3 & y>=0.3 & y<=0.7, 1, 0)
critere_fct_caracteristique obstacle_droite_1       [fct_obstacle_droite_1, 0]
cree_entite_avec_critere    droite_obstacle_1       ENTITE_ARETES_SSC(obstacle_droite_1)



# ------------------------------------------------------------
# Obstacle entier 1
# ------------------------------------------------------------

## Devrait etre tout sauf les sommets de l'obstacle 1

scalaire                    fct_obstacle_1           if(x>0.1 & x<0.3 & y>0.3 & y<0.7, 1, 0)
critere_fct_caracteristique fct_car_obstacle_1       [fct_obstacle_1, 0]
cree_entite_avec_critere    obstacle_1               ENTITE_TOUTES_COMPOSANTES(fct_car_obstacle_1)


## Definition des sommets de l'obstacle 1
scalaire                    sommmets_fct_obstacle_1          if(x>0.1 & x<0.3 & y>0.3 & y<0.7, 1, 0)
critere_fct_caracteristique sommets_fct_car_obstacle_1       [sommmets_fct_obstacle_1, 0]
cree_entite_avec_critere    sommets_obstacle_1                ENTITE_SOMMETS(sommets_fct_car_obstacle_1)



# ------------------------------------------------------------
# Sous-domaine moins les obstacles
# ------------------------------------------------------------

cree_entite sous_domaine_cropped sous_domaine
#cree_entite sous_domaine_cropped sous_domaine - obstacle_1 + sommets_obstacle_1



# ================================================= 0.5 Initialisation des positions des especes     ===================================================================
## Definition de quelles espèces sont présentes initialement et à quelles positions
include position_densite_initiale.champs



# ================================================= 0.6 Charger les coefficients de selection qui viennent des iSSA ========================================================

### For caribou
include beta_Boreal_Caribou_habitat_selection_coefficients.champs
include beta_Boreal_Caribou_diversity_selection_coefficients.champs
include beta_Boreal_Caribou_conspecific_selection_coefficients.champs
include beta_Boreal_Caribou_moose_selection_coefficients.champs
include beta_Boreal_Caribou_wolf_selection_coefficients.champs
include beta_Boreal_Caribou_deer_selection_coefficient.champs

### For moose
include beta_Moose_habitat_selection_coefficients.champs
include beta_Moose_diversity_selection_coefficients.champs
include beta_Moose_conspecific_selection_coefficients.champs
include beta_Moose_other_prey_selection_coefficients.champs
include beta_Moose_wolf_selection_coefficients.champs

### For wolf
include beta_Gray_Wolf_habitat_selection_coefficients.champs
include beta_Gray_Wolf_diversity_selection_coefficients.champs
include beta_Gray_Wolf_conspecific_selection_coefficients.champs
include beta_Gray_Wolf_caribou_selection_coefficients.champs

## TODO: CHECKER LA VALEUR DANS LA LITTERATURE
include beta_Gray_Wolf_moose_selection_coefficients.champs


### TODO: CHECKER LA VALEUR DANS LA LITTERATURE ---  Deer
include beta_Deer_conspecific_selection_coefficients.champs

# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#                                                      ====       DIFFUSION SIMPLE      ====
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

## Importe les valeurs des coefficients de diffusion
include diffusion_parms.champs




## Creation des tenseurs 3D
## C'est une matrice symetrique en 2D 3x3, qui a pour valeurs sur la diagonale les 3 premieres valeurs du tenseur, et en autres valeurs les 3 derniers termes du tenseur.
empilementto2 DC    [coeff_diffusion_C_norm, coeff_diffusion_C_norm, coeff_diffusion_C_norm, Zero, Zero, Zero]
empilementto2 DM    [coeff_diffusion_M_norm, coeff_diffusion_M_norm, coeff_diffusion_M_norm, Zero, Zero, Zero]
empilementto2 DP    [coeff_diffusion_P_norm, coeff_diffusion_P_norm, coeff_diffusion_P_norm, Zero, Zero, Zero]
empilementto2 DD1   [coeff_diffusion_D_norm, coeff_diffusion_D_norm, coeff_diffusion_D_norm, Zero, Zero, Zero]




# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 1.3.3 Cross-diffusion                               -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

#### TODO: checker le pb numerique selon taille de L
include rayon_perception.champs


## Initialisation de tous les champs intermediaires utilises pour le calcul des moyennages locaux
include initialisation_champs_moyennage_local.champs


# ------------------------------------------------- For caribou                            -------------------------------------------------------------------

scalaire M1_C c1 * (C_landcover1 * Z1 + C_landcover2 * Z1 + C_landcover3 * Z3 + C_landcover4 * Z4 + C_landcover5 * Z5 + C_landcover6 * Z6 + C_landcover7 * Z7 + C_landcover8 * Z8 + C_landcover9 * Z9 + C_landcover11 * Z11 + C_landcover12 * Z12  )
scalaire M2_C c2 * (C_diversity1 * Y1 + C_diversity2 * Y2 + C_diversity3 * Y3 + C_diversity4 * Y4 + C_diversity5 * Y5 + C_diversity6 * Y6)
scalaire M3_C c3 * C_cons_dens * C
scalaire M4_C c4 * C_moose_dens * M
scalaire M5_C c5 * C_wolf_dens * P

scalaire mec_tot_C M1_C + M2_C + M3_C + M4_C + M5_C
gradient grad_mec_tot_C  mec_tot_C

## Moyennage de tout le gradeint (en utilisant les pp)
scalaire mec_tot_C_avg averaged_mec_tot_C_cont

gradient grad_tot_C  mec_tot_C_avg


# ------------------------------------------------- For moose                            -------------------------------------------------------------------

scalaire M1_M m1 * (M_landcover1 * Z1 + M_landcover2 * Z2 + M_landcover3 * Z3 + M_landcover4 * Z4 + M_landcover5 * Z5 + M_landcover6 * Z6 + M_landcover7 * Z7 + M_landcover8 * Z8 + M_landcover9 * Z9 + M_landcover11 * Z11 + M_landcover12 * Z12  )
scalaire M2_M m2 * (M_diversity1 * Y1 + M_diversity2 * Y2 + M_diversity3 * Y3 + M_diversity4 * Y4 + M_diversity5 * Y5 + M_diversity6 * Y6)
scalaire M3_M m3 * M_cons_dens * M
scalaire M4_M m4 * M_other_prey_dens * C
scalaire M5_M m5 * M_wolf_dens * P

scalaire mec_tot_M    M1_M + M2_M + M3_M + M4_M + M5_M
gradient grad_mec_tot_M  mec_tot_M

## Moyennage de tout le gradeint (en utilisant les pp)
scalaire mec_tot_M_avg averaged_mec_tot_M_cont

gradient grad_tot_M  mec_tot_M_avg



# ------------------------------------------------- For WTD                            -------------------------------------------------------------------

#scalaire M1_D1 d1 * (P_landcover1 * Z1 + D1_landcover2 * Z2 + D1_landcover3 * Z3 + D1_landcover4 * Z4 + D1_landcover5 * Z5 + D1_landcover6 * Z6 + D1_landcover7 * Z7 + D1_landcover8 * Z8 + D1_landcover9 * Z9 + D1_landcover11 * Z11 + D1_landcover12 * Z12  )
#scalaire M2_D1 d2 * (D1_diversity1 * Y1 + D1_diversity2 * Y2 + D1_diversity3 * Y3 + D1_diversity4 * Y4 + D1_diversity5 * Y5 + D1_diversity6 * Y6)
#scalaire M3_D1 d3 * D1_cons_dens * D1
#scalaire M4_D1 d4 * D1_other_prey_dens * C
#scalaire M5_D1 d5 * D1_wolf_dens * P

#scalaire mec_tot_D1 M1_D1 + M2_D1 + M3_D1 + M4_D1 + M5_D1

## Moyennage de tout le gradeint (en utilisant les pp)
#scalaire mec_tot_D1_avg averaged_mec_tot_D1_cont

#gradient grad_tot_D1  mec_tot_D1_avg



# ------------------------------------------------- For predator                            -------------------------------------------------------------------

#scalaire M1_P p1 * (P_landcover1 * Z1 + P_landcover2 * Z2 + P_landcover3 * Z3 + P_landcover4 * Z4 + P_landcover5 * Z5 + P_landcover6 * Z6 + P_landcover7 * Z7 + P_landcover8 * Z8 + P_landcover9 * Z9 + P_landcover11 * Z11 + P_landcover12 * Z12  )
#scalaire M2_P p2 * (P_diversity1 * Y1 + P_diversity2 * Y2 + P_diversity3 * Y3 + P_diversity4 * Y4 + P_diversity5 * Y5 + P_diversity6 * Y6)
scalaire M3_P p3 * P_caribou_dens * C
scalaire M4_P p4 * P_cons_dens * P
scalaire M5_P p5 * P_moose_dens * C

#scalaire mec_tot_P M1_P + M2_P + M3_P + M4_P + M5_P
scalaire mec_tot_P M3_P + M4_P + M5_P
gradient grad_mec_tot_P  mec_tot_P

## Moyennage de tout le gradeint (en utilisant les pp)
scalaire mec_tot_P_avg averaged_mec_tot_P_cont

gradient grad_tot_P  mec_tot_P_avg




# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- M6  - Invasive prey species                            -------------------------------------------------------------------

## WTD - Northward invasion of the species
## On définit un vecteur en 3D qui va transporter H3 selon l'axe des y (vers le nord)
#scalaire advection_coeff 1
#scalaire scalTD1 1e-3
#empilementto2 TD1 [Zero, scalTD1, Zero, Zero, Zero, Zero]


## Lorsque l'advection est constante dans le temps, on peut definir le coefficient d'advection par un vecteur
## Valeur empirique de la vitesse d'invasion de D (km/year)
scalaire travel_speed_D1 3.33
## Coefficient d'advection, utilise pour ponderer la force du mecanisme par rapport aux autres
scalaire coef_advection_D1 1
## Direction d'advection
scalaire scalTD1 1

## Selon ce qu'on veut, advection verticale ou horizontale
#vectoriel3D TD1 [0, travel_speed_D1, 0]
# Puisqu'on veut normaliser:
vectoriel3D TD1 [0, 1, 0]








#==========================================================================================================================================================================
#==========================================================================================================================================================================

# ================================================= 2. PREPARATION DES EQUATIONS POUR RESOLUTION                                               ============================




#==========================================================================================================================================================================
# ================================================= 2.2 Definition d'un probleme element fini pour MEF  ===================================================================

# Création d'un ProblemeEF pour accueillir TFs, PPs, CLs, Exportations:
# ici on nomme notre problème probDida :
problemeef probDida

# Création d'exportations attachées à probDida:
{ exportation            probDida
  format_exportation     GIREF
  format_exportation     VTK
  degre_interpolation LIN

  # On ajoute les champs qu'on veut retrouver en sortie, visibles dans Paraview
  #ajoute_champ            coeff_diffusion_P_norm
  #ajoute_champ            scalDP
  ajoute_champ            valeurs_paysage
  ajoute_champ            valeurs_diversity
  #ajoute_champ            DP_sp
  #ajoute_champ            grad_tot_C_post
  #ajoute_champ            testP
  #ajoute_champ            fct_bornes_domaine
  ajoute_champ            grad_tot_C
  ajoute_champ            grad_tot_M
  ajoute_champ            grad_tot_P
  #ajoute_champ            mult_c
  #ajoute_champ            averaged_CZ1_cont
  #ajoute_champ            Z1
  #ajoute_champ            log_lim_C
  #ajoute_champ            grad_tot_C_not_moy
  #ajoute_champ            averaged_PM
  #ajoute_champ            averaged_PC
  ajoute_champ            P
  ajoute_champ            C
  ajoute_champ            D1
  ajoute_champ            M
  ajoute_eq_latex probDida


  ## Pour aussi exporter les entités (utile pour visualiser les contours des obstacles, par ex)
  ajoute_entites_geo_en_champs true


  # Nom des fichiers de sorties. Important: pour exécuter le code, il faut supprimer la partie
  # $CheminAccesExport$/ (utile seulement pour les tests de validation) :
  # TODO: a changer
      prefixe_sorties $CheminAccesExport$/simulations/C_diff_crossdiff/


}


pp_exportation ppExports [probDida, "exports", 4, true]

## Definition du temps initial
scalaire t0 0

# Il y a plusieurs façon d'exprimer le solveur instationnai re. L'une d'elle est d'exprimer
# le nombre de pas de temps total voulu ainsi que la valeur de chaque pas.

## Definition du pas de temps
scalaire delta_t 0.0001

## Definition du nombre de pas de temps
scalaire nombre_de_pas_de_temps 1

## Definition du temps final
#scalaire tf 3


#==========================================================================================================================================================================
# ================================================= 2.3 Definition des Pré et Post PostTraitements      ===================================================================

# On définit ici les fonctions (~actions), qui seront roulées en court de résolution des PDE. On décide ensuite l'ordre de leur execution a la fin du script.

include def_pre_post_traitements.champs



#==========================================================================================================================================================================
# ================================================= 2.4 Définition des termes de formulation (TF)                                       ===================================

## On définit ici tous les termes de formulation (faits en partie avec eMEF), permettant de décrire chaque morceau des équations

## Partie SUPG
scalaire petit_diff 1e-1
empilementto2 no_diff_C    [petit_diff,petit_diff,petit_diff, Zero, Zero, Zero]
alias no_diff_M=no_diff_C no_diff_P=no_diff_C no_diff_D1=no_diff_C
#empilementto2 no_diff_M    [petit_diff,petit_diff,petit_diff, Zero, Zero, Zero]
#empilementto2 no_diff_P    [petit_diff, petit_diff, petit_diff, Zero, Zero, Zero]
#empilementto2 no_diff_D1   [petit_diff, petit_diff, petit_diff, Zero, Zero, Zero]

{ decl_hugn_C
  alias U=grad_mec_tot_C
  booleen hugn_utilise_schema_const_pour_hugn_C faux
}
scalh_ugn hugn_C   decl_hugn_C

{ decl_hugn_M
  alias U=grad_mec_tot_M
  booleen hugn_utilise_schema_const_pour_hugn_M faux
}
scalh_ugn hugn_M   decl_hugn_M

{ decl_hugn_P
  alias U=grad_mec_tot_P
  booleen hugn_utilise_schema_const_pour_hugn_P faux
}
scalh_ugn hugn_P   decl_hugn_P

{ decl_hugn_D1
  alias U=TD1
  booleen hugn_utilise_schema_const_pour_hugn_D1 faux
}
scalh_ugn hugn_D1   decl_hugn_D1

## Avec delta_t
scalaire         Tau_tC      1. / sqrt (4/delta_t^2 + 4*norme2(V3D(decl_hugn_C::U))^2  / hugn_C^2 + 9.*16.*no_diff_C[00]^2   / hugn_C^4  + 4/delta_t^2 + 1e-8)
## Sans delta_t
#scalaire          Tau_tC 1. / sqrt (4*norme2(V3D(decl_hugn_C::U))^2 / hugn_C^2  +  9.*16.*no_diff_C[00]^2 / hugn_C^4)

fcts_supg       phi_C_supg [Tau_tC,C,decl_hugn_C::U]

## Avec delta_t
scalaire         Tau_tM      1. / sqrt (4/delta_t^2 + 4*norme2(V3D(decl_hugn_M::U))^2  / hugn_M^2 + 9.*16.*no_diff_M[00]^2   / hugn_M^4  + 4/delta_t^2 + 1e-8)
## Sans delta_t
#scalaire          Tau_tM 1. / sqrt (4*norme2(V3D(decl_hugn_M::U))^2 / hugn_M^2  +  9.*16.*no_diff_M[00]^2 / hugn_M^4)

fcts_supg       phi_M_supg [Tau_tM,M,decl_hugn_M::U]

## Avec delta_t
scalaire         Tau_tP      1. / sqrt (4/delta_t^2 + 4*norme2(V3D(decl_hugn_P::U))^2  / hugn_P^2 + 9.*16.*no_diff_P[00]^2   / hugn_P^4  + 4/delta_t^2 + 1e-8)
## Sans delta_t
#scalaire          Tau_tP 1. / sqrt (4*norme2(V3D(decl_hugn_P::U))^2 / hugn_P^2  +  9.*16.*no_diff_P[00]^2 / hugn_P^4)

fcts_supg       phi_P_supg [Tau_tP,P,decl_hugn_P::U]

## Avec delta_t
scalaire         Tau_tD1      1. / sqrt (4/delta_t^2 + 4*norme2(V3D(decl_hugn_D1::U))^2  / hugn_D1^2 + 9.*16.*no_diff_D1[00]^2   / hugn_D1^4  + 4/delta_t^2 + 1e-8)
## Sans delta_t
#scalaire          Tau_tD1 1. / sqrt (4*norme2(V3D(decl_hugn_D1::U))^2 / hugn_D1^2  +  9.*16.*no_diff_D1[00]^2 / hugn_D1^4)

fcts_supg       phi_D1_supg [Tau_tD1,D1,decl_hugn_D1::U]

{ probDida

ajoutePrePostTraitement [ppExports, FinPasDeTemps]

# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.4.3 TF de C                                      -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------


  ### ----------------------------- Termes de diffusion simple
  ## on veut resoudre l'equation de la diffusion seulement dans le domaine qui n'est pas l'obstacle (sous-domaine)
  #tfdiffusion                    tfDiffusionC                                   [champgeo, C, C, DC, schema_intg, defaut::sous_domaine_cropped]
  #tfdiffusion                    tfDiffusionC                                  [champgeo, C, C, DC, schema_intg]


  #tfdiffusion                    tfDiffusionC                                  [champgeo,  C, C, no_diff_C, schema_intg, defaut::sous_domaine_cropped]
  #tfdiffusion                    tfDiffusionC                                  [champgeo,  C, C, no_diff_C, schema_intg]


  ## ---------------------------- Termes de diffusion croisée
  ## Terme qui incorpore le gradient de l'ensemble des ressources i auxquels C est sensible, pondérés par les facteurs c_i
  #formulation_transport_diffusion_inst          transport_C                    [schema_intg, grad_tot_C, (C, no_diff_C, mult_c)]
  #formulation_transport_diffusion_inst          transport_C                    [schema_intg, mec_tot_C, (C, no_diff_C, mult_c)]
  formulation_transport_diffusion_inst_supg          transport_C                    [schema_intg, mec_tot_C, (C, DC, mult_c)]


  ### ----------------------------- Termes de reaction

  #tfmassegenscal                 tfCroissanceC                                 [champgeo, C, C, coeffCroissance_C, schema_intg]
  #tfmassegenscal                 tfDensiteDepC                                 [champgeo, C, C, coeffDensiteDep_C, schema_intg]
  #tfmassegenscal                 tfPredationCP                                 [champgeo, C, C, coeffPredation_CP, schema_intg]




# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.4.3 TF de M                                      -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  ### ----------------------------- Termes de diffusion
  #tfdiffusion                    tfDiffusionM                                [champgeo, M, M, DM, schema_intg]

  #tfdiffusion                    tfDiffusionM                                   [champgeo, M, M, no_diff_M, schema_intg]



  ## ---------------------------- Termes de diffusion croisée

  ## Terme qui incorpore le gradient de l'ensemble des ressources i auxquels M est sensible, pondérés par les facteurs m_i
  #formulation_transport_diffusion_inst          transport_M                  [schema_intg, grad_tot_M, (M, no_diff_M, mult_m)]
  #formulation_transport_diffusion_inst          transport_M                  [schema_intg, mec_tot_M, (M, no_diff_M, mult_m)]
  formulation_transport_diffusion_inst_supg          transport_M                  [schema_intg, mec_tot_M, (M, DM, mult_m)]


  ### ----------------------------- Termes de reaction

  #tfmassegenscal                 tfCroissanceM                                 [champgeo, M, M, coeffCroissance_M, schema_intg]
  #tfmassegenscal                 tfDensiteDepM                                 [champgeo, M, M, coeffDensiteDep_M, schema_intg]
  #tfmassegenscal                 tfPredationMP                                 [champgeo, M, M, coeffPredation_MP, schema_intg]


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.4.3 TF de P                                      -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  ### ----------------------------- Termes de diffusion
  #tfdiffusion                    tfDiffusionP                                   [champgeo, P, P, DP, schema_intg, defaut::sous_domaine_cropped]
  #tfdiffusion                    tfDiffusionP                                   [champgeo, P, P, DP, schema_intg]
  #tfdiffusion                    tfDiffusionP                                   [champgeo, P, P, no_diff_P, schema_intg]


  ## ---------------------------- Termes de diffusion croisée

  ## Terme qui incorpore le gradient de l'ensemble des ressources i auxquels P est sensible, pondérés par les facteurs p_i
  #formulation_transport_diffusion_inst          transport_P                  [schema_intg, grad_tot_P, (P, no_diff_P, mult_p)]
  #formulation_transport_diffusion_inst          transport_P                  [schema_intg, mec_tot_P, (P, no_diff_P, mult_p)]
