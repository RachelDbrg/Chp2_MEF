  # (il y a une intégrale de bord à calculer):


{ probDida

# ------------------------------------ Frontieres de paysage ------------------------------------------------------------------------------------------------------------

## Neumann: impose une valeur a la derivee normale par rapport a l'entite ((ie caracterise le flux))
scalaire flux_frontiere 0


neumann [bas, D1, flux_frontiere, schema_intg]
neumann [haut, D1, flux_frontiere, schema_intg]
neumann [gauche, D1, flux_frontiere, schema_intg]
neumann [droite, D1, flux_frontiere, schema_intg]


