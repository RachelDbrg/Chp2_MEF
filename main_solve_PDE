def apply_model_dependent_parameters(
    gfc,
    name_parm,
    value_parm
):

    for name, value in zip(
        name_parm,
        value_parm
    ):

        gfc.reqChamp(name).asgnValeur(
            value
        )

    print(
        "Parametres dependant du modele:"
    )

    print(
        dict(
            zip(
                name_parm,
                value_parm
            )
        )
    )


