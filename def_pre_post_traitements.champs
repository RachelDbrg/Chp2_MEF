#==========================================================================================================================================================================
# ================================================= 2.3 Definition des Pré et Post PostTraitements      ===================================================================

# On définit ici les fonctions (~actions), qui seront roulées en court de résolution des PDE. On décide ensuite l'ordre de leur execution a la fin du script. 

# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.3.2 Moyennage locaux                  -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

## Etape 0: discretisation des champs espèces car il faut un ChampScalConstElem pour que le pp_filtrage_moyenne fonctionne
## pp_reinterpole a pour effet de passer un champ de continu a discret
## La syntaxe du pp_reinterpole est:                                    [champ_destination, champ_source]

pp_reinterpole                      pp_reinterpole_Phi_C                   [Phi_C_reinterpol,      Phi_C]
pp_reinterpole                      pp_reinterpole_Phi_M                   [Phi_M_reinterpol,      Phi_M]
pp_reinterpole                      pp_reinterpole_Phi_P                   [Phi_P_reinterpol,      Phi_P]
pp_reinterpole                      pp_reinterpole_Phi_D                   [Phi_D_reinterpol,      Phi_D]




### Etape 1: Application du pp_filtrage_moyenne, qui moyenne les champs selon le rayon de perception voulu
## La syntaxe du pp_filtrage_moyenne est:                               [champ_source, champ_destination, rayon d'action]
## ou le champ de destination averaged_XY reflete la moyenne (discrete) de l'espece Y en fonction de la perception de l'espece X

### Moyennage type vegetation (mecanisme 1)

pp_filtrage_moyenne                 pp_moyenne_locale_Phi_C               [Phi_C_reinterpol,  avg_Phi_C_disc,        rayon_perception_C_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_Phi_M               [Phi_M_reinterpol,  avg_Phi_M_disc,        rayon_perception_M_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_Phi_P               [Phi_P_reinterpol,  avg_Phi_P_disc,        rayon_perception_P_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_Phi_D               [Phi_D_reinterpol,  avg_Phi_D_disc,        rayon_perception_D_norm]





### Etape 2: Conversion de discret en continu
## Projection L2 pour convertir discret en continu
## La syntaxe du pp_projection_l2 est:                                  [champ_source, champ_destination, schema integration]

pp_projection_l2                    projection_l2_Phi_C              [avg_Phi_C_disc,   avg_Phi_C,   schema_intg]
pp_projection_l2                    projection_l2_Phi_M              [avg_Phi_M_disc,   avg_Phi_M,   schema_intg]
pp_projection_l2                    projection_l2_Phi_P              [avg_Phi_P_disc,   avg_Phi_P,   schema_intg]
pp_projection_l2                    projection_l2_Phi_D              [avg_Phi_D_disc,   avg_Phi_D,   schema_intg]
