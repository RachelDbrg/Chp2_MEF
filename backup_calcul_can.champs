#==========================================================================================================================================================================
# ================================================= 2.5 Définition conditions limites                                                   ===================================

  # Conditions aux limites. On écrit le type de condition, puis on indique l'entité sur laquelle  
  # se trouve la condition, puis la variable touchée par la condition (ici T pour température) et
  # finalement la condition. Il faut ajouter "schema_intg" après une condition autre que Dirichlet
  # (il y a une intégrale de bord à calculer):


{ probDida

# ------------------------------------ Frontieres de paysage ------------------------------------------------------------------------------------------------------------

## Neumann: impose une valeur a la derivee normale par rapport a l'entite ((ie caracterise le flux))
scalaire flux_frontiere 0



#neumann scalaire "bas" "D1" "flux_frontiere" "schema_intg"
#neumann scalaire "haut" "D1" "flux_frontiere" "schema_intg"
#neumann scalaire "gauche" "D1" "flux_frontiere" "schema_intg"
#neumann scalaire "droite" "D1" "flux_frontiere" "schema_intg"


neumann scalaire "bas" "P" "flux_frontiere" "schema_intg"
neumann scalaire "haut" "P" "flux_frontiere" "schema_intg"
neumann scalaire "gauche" "P" "flux_frontiere" "schema_intg"
neumann scalaire "droite" "P" "flux_frontiere" "schema_intg"

neumann scalaire "bas" "M" "flux_frontiere" "schema_intg"
neumann scalaire "haut" "M" "flux_frontiere" "schema_intg"
neumann scalaire "gauche" "M" "flux_frontiere" "schema_intg"
neumann scalaire "droite" "M" "flux_frontiere" "schema_intg"

## Dirichlet: impose une valeur aux limites du paysage
  # scalaire beaucoup 3000
  # dirichlet scalaire "bas" "H1" "beaucoup"
  # dirichlet scalaire "haut" "H1" "beaucoup"
  # dirichlet scalaire "gauche" "H1" "beaucoup"
  # dirichlet scalaire "droite" "H1" "beaucoup"


neumann scalaire "bas" "C" "flux_frontiere" "schema_intg"
neumann scalaire "haut" "C" "flux_frontiere" "schema_intg"
neumann scalaire "gauche" "C" "flux_frontiere" "schema_intg"
neumann scalaire "droite" "C" "flux_frontiere" "schema_intg"


# ------------------------------------ Obstacle ------------------------------------------------------------------------------------------------------------

## Conditions limites par rapport a une frontiere
## Neumann: impose une valeur a la derivee normale par rapport a l'entite ((ie caracterise le flux))


#neumann scalaire "bas_obstacle" "C" "flux_frontiere" "schema_intg"
#neumann scalaire "haut_obstacle" "C" "flux_frontiere" "schema_intg"
#neumann scalaire "gauche_obstacle" "C" "flux_frontiere" "schema_intg"
#neumann scalaire "droite_obstacle" "C" "flux_frontiere" "schema_intg"


#neumann scalaire "bas_obstacle" "P" "flux_frontiere" "schema_intg"
#neumann scalaire "haut_obstacle" "P" "flux_frontiere" "schema_intg"
#neumann scalaire "gauche_obstacle" "P" "flux_frontiere" "schema_intg"
#neumann scalaire "droite_obstacle" "P" "flux_frontiere" "schema_intg"

## test de mettre CL Dirichlet nulle dans le sous-domaine
#dirichlet scalaire "sous_domaine" "C" "flux_frontiere"



}

#==========================================================================================================================================================================
# ================================================= 2.6 Ajout des Pre-Post Traitements                                                  ===================================

{ probDida
  ### OBS - PP pour obtenir les scores max et min de chaque champ 
  #ajoutePrePostTraitement [get_min_max_G_H1, FinPasDeTemps]
  #ajoutePrePostTraitement [get_min_max_G_H2, FinPasDeTemps]
  #ajoutePrePostTraitement [get_min_max_G_H3, FinPasDeTemps]
  #ajoutePrePostTraitement [get_min_max_G_P, FinPasDeTemps]


  ## OBS - Calcul de l'integrale de ki pour en calculer la moyenne sur un rayon delta
  #ajoutePrePostTraitement [pp_calcul_ki_averaged_over_delta, FinPasDeTemps]
  #ajoutePrePostTraitement [pp_calcul_mi_averaged_over_delta, FinPasDeTemps]
  #ajoutePrePostTraitement [pp_calcul_p_averaged_over_delta, FinPasDeTemps]


  ## Local averaging: calcul de l'integrale de C sur qques elements autour du point d'integration
  #ajoutePrePostTraitement [pp_somme_locale_C, FinPasDeTemps]


  ## Local averaging: calcul de l'integrale de pi
  #ajoutePrePostTraitement [pp_local_averaging_pi, FinPasDeTemps]

  
  ## Local averaging: calcul de l'integrale de ki
  #ajoutePrePostTraitement [pp_local_averaging_ki, FinPasDeTemps]


  ## Moyennage local de C
  #ajoute_pp [pp_exportInitial, AvantPremierPasTemps]
  #ajoutePrePostTraitement [pp_moyenne_locale_CC, FinPasDeTemps]


## Pre-traitement pour convertir l'expression algébrique qui normalise le rayon percu selon la taille du paysage
  ajoutePrePostTraitement [pp_reinterpole_rayon_norm_C, AvantPremierPasTemps]
  ajoutePrePostTraitement [pp_reinterpole_rayon_norm_M, AvantPremierPasTemps]
  ajoutePrePostTraitement [pp_reinterpole_rayon_norm_P, AvantPremierPasTemps]
  ajoutePrePostTraitement [pp_reinterpole_rayon_norm_D, AvantPremierPasTemps]


## Pre-traitement pour reinterpoler les densites initiales en champ constant par element, necessaire pour utiliser le pp_filtrage_moyenne
  ajoutePrePostTraitement [pp_reinterpole_C, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_reinterpole_M, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_reinterpole_P, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_reinterpole_D, DebutBoucleNlin]


## Pre-traitement pour calculer les moyennage locaux 
  ajoutePrePostTraitement [pp_moyenne_locale_CC, DebutBoucleNlin]
  #ajoutePrePostTraitement [pp_moyenne_locale_MM, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_moyenne_locale_PP, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_moyenne_locale_CP, DebutBoucleNlin]
  ajoutePrePostTraitement [pp_moyenne_locale_PC, DebutBoucleNlin]
  
  ajoutePrePostTraitement [pp_moyenne_locale_CM, DebutBoucleNlin]
  

## Pre-traitement de projection L2 pour transformer discret en continu
  ajoutePrePostTraitement [projection_l2_CM, DebutBoucleNlin]
  #ajoutePrePostTraitement [projection_l2_CM, JusteAvantResoudre]
  #ajoutePrePostTraitement [projection_l2_CM, FinIterationNlin]

  ajoutePrePostTraitement [projection_l2_CP, DebutBoucleNlin]
  #ajoutePrePostTraitement [projection_l2_CP, JusteAvantResoudre]
  #ajoutePrePostTraitement [projection_l2_CP, FinIterationNlin]

  ajoutePrePostTraitement [projection_l2_CD, DebutBoucleNlin]
  #ajoutePrePostTraitement [projection_l2_CD, JusteAvantResoudre]
  #ajoutePrePostTraitement [projection_l2_CD, FinIterationNlin]

  ajoutePrePostTraitement [projection_l2_CC, DebutBoucleNlin]
  #ajoutePrePostTraitement [projection_l2_CC, JusteAvantResoudre]
  #ajoutePrePostTraitement [projection_l2_CC, FinIterationNlin]

  
  ajoutePrePostTraitement [projection_l2_PC, DebutBoucleNlin]
  


}

