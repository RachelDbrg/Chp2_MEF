# ------------------------------------------------- M3 - Selection for conspecific                               -------------------------------------------------------------


# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ---------------------------------------------------------- Scenario 1 ------------------------------------------------------------------------------------------------------

## Etape 1 - Initialisation des champs utilisés dans le pp filtrage moyenne

#### TODO: checker le pb numerique selon taille de L
include rayon_perception.champs


### Expression algébrique pour normaliser le rayon selon la taille du paysage
scalaire "alg_rayon_perception_C_norm" f(rayon_perception_C,L)=rayon_perception_C/L
scalaire "alg_rayon_perception_M_norm" f(rayon_perception_M,L)=rayon_perception_M/L
scalaire "alg_rayon_perception_P_norm" f(rayon_perception_P,L)=rayon_perception_P/L
scalaire "alg_rayon_perception_D_norm" f(rayon_perception_D,L)=rayon_perception_D/L


### Initialisation du scalaire de perception normalise
scalaire rayon_perception_C_norm 1 
scalaire rayon_perception_M_norm 1 
scalaire rayon_perception_P_norm 1 
scalaire rayon_perception_D_norm 1 


### Initialisation des champs de sorties du pp filtrage moyenne
scalconstelem averaged_CC 0 
scalconstelem averaged_CM 0 
scalconstelem averaged_CP 0 
scalconstelem averaged_CD 0 
scalconstelem C_reinterpol 0

scalconstelem averaged_MM 0 
scalconstelem averaged_MC 0 
scalconstelem averaged_MP 0 
scalconstelem averaged_MD 0 
scalconstelem M_reinterpol 0

scalconstelem averaged_PP 0 
scalconstelem averaged_PC 0 
scalconstelem averaged_PM 0 
scalconstelem averaged_PD 0 
scalconstelem P_reinterpol 0

scalconstelem averaged_DD 0 
scalconstelem averaged_DM 0 
scalconstelem averaged_DP 0 
scalconstelem averaged_DC 0 
scalconstelem D_reinterpol 0





# ================================================= 3.1 Local average of the species itself                      =============================================================

## Definition d'un cercle de rayon r, qui servira d'entite pour le pp_calcul_integrale_champ_scalaire
## Correspond a un cercle de perception autour de chaque point d'integration, et correspond a une valeur moyenne d'un champs


# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
### For caribou
## Definition du coefficient d'advection
scalaire c3 3
scalaire mult_c3 -2 * coeff_diffusion_C_norm


### Initialisation
scallin averaged_CC_cont 0 

scalaire M3_C c3 * C_cons_dens * averaged_CC_cont


## Calcul du gradient du coefficient d'advection
#gradient grad_c3 c3

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM3_C M3_C

## Calcul du Laplacien de M3_C
### En x 
gradient der_sec_par_rapport_x_gradM3_C_cons_sel gradM3_CX

### En y 
gradient der_sec_par_rapport_y_gradM3_C_cons_sel gradM3_CY

### Calcul du Laplacien
scalaire laplacien_M3_C der_sec_par_rapport_x_gradM3_C_cons_selX + der_sec_par_rapport_y_gradM3_C_cons_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_C_cons_sel -2*laplacien_M3_C


# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
### For moose
## Definition du coefficient d'advection
scalaire m3 1
scalaire mult_m3 -2 * coeff_diffusion_M_norm


### Initialisation
scallin averaged_MM_cont 0 

scalaire M3_M m3 * M_cons_dens * averaged_MM_cont



## Calcul du gradient du coefficient d'advection
gradient grad_m3 m3

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM3_M M3_M

## Calcul du Laplacien de M3_M
### En x 
gradient der_sec_par_rapport_x_gradM3_M_cons_sel gradM3_MX

### En y 
gradient der_sec_par_rapport_y_gradM3_M_cons_sel gradM3_MY

### Calcul du Laplacien
scalaire laplacien_M3_M der_sec_par_rapport_x_gradM3_M_cons_selX + der_sec_par_rapport_y_gradM3_M_cons_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_M_cons_sel -2*laplacien_M3_M

# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For predator
## Definition du coefficient d'advection
scalaire p3 1

### Initialisation
scallin averaged_PP_cont 0 
scalaire M3_P p3 * P_cons_dens * averaged_PP_cont

scalaire mult_p3 -2 * coeff_diffusion_P_norm

## Calcul du gradient du coefficient d'advection
gradient grad_p3 p3

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM3_P M3_P

## Calcul du Laplacien de M3_P
### En x 
gradient der_sec_par_rapport_x_gradM3_P_cons_sel gradM3_PX

### En y 
gradient der_sec_par_rapport_y_gradM3_P_cons_sel gradM3_PY

### Calcul du Laplacien
scalaire laplacien_M3_P der_sec_par_rapport_x_gradM3_P_cons_selX + der_sec_par_rapport_y_gradM3_P_cons_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_P_cons_sel -2*laplacien_M3_P


# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
## TODO - revoir tous les parametres ici

### For deer
## Definition du coefficient d'advection
scalaire d3 1

### Initialisation
scallin averaged_DD_cont 0 
scalaire M3_D d3 * M_cons_dens * averaged_DD_cont

scalaire mult_d3 -2* coeff_diffusion_D_norm

## Calcul du gradient du coefficient d'advection
gradient grad_d3 d3

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM3_D M3_D

## Calcul du Laplacien de M3_D
### En x 
gradient der_sec_par_rapport_x_gradM3_D_cons_sel gradM3_DX

### En y 
gradient der_sec_par_rapport_y_gradM3_D_cons_sel gradM3_DY

### Calcul du Laplacien
scalaire laplacien_M3_D der_sec_par_rapport_x_gradM3_D_cons_selX + der_sec_par_rapport_y_gradM3_D_cons_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_D_cons_sel -2*laplacien_M3_D



# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- M4  - Other native prey species                        -------------------------------------------------------------------


### For caribou
## Definition du coefficient d'advection
# Negatif si on veut de la repulsion (vraiment vrai ca???)
scalaire c4 3

scalaire mult_c4 -2 * coeff_diffusion_C_norm


#### TEST 

## La projection L2 sert a passer d'un champ discret a un champ continu 
## syantaxe: projection_l2(schema_intg) b=a (!!! Attention aux espaces)
## ou a est discret et b est la projection continue

### Initialisation
scallin averaged_CM_cont 0 

scalaire M4_C c4 * C_moose_dens * averaged_CM_cont



## Calcul du gradient du coefficient d'advection
#gradient grad_c4 c4

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM4_C M4_C

## Calcul du Laplacien de M4_C
### En x 
gradient der_sec_par_rapport_x_gradM4_C_other_prey_sel gradM4_CX

### En y 
gradient der_sec_par_rapport_y_gradM4_C_other_prey_sel gradM4_CY

### Calcul du Laplacien
scalaire laplacien_M4_C der_sec_par_rapport_x_gradM4_C_other_prey_selX + der_sec_par_rapport_x_gradM4_C_other_prey_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_C_other_prey_sel -2*laplacien_M4_C
#scalaire terme_masse_adv_C_other_prey_sel 2*laplacien_M4_C




### -------------------------------------------


### For moose
## Definition du coefficient d'advection
scalaire m4 1
scalaire mult_m4 -2 * coeff_diffusion_M_norm

### Initialisation
scallin averaged_MC_cont 0 

scalaire M4_M m4 * M_other_prey_dens * averaged_MC_cont 


## Calcul du gradient du coefficient d'advection
#gradient grad_m4 m4

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM4_M M4_M

## Calcul du Laplacien de M4_C
### En x 
gradient der_sec_par_rapport_x_gradM4_M_other_prey_sel gradM4_MX

### En y 
gradient der_sec_par_rapport_y_gradM4_M_other_prey_sel gradM4_MY

### Calcul du Laplacien
scalaire laplacien_M4_M der_sec_par_rapport_x_gradM4_M_other_prey_selX + der_sec_par_rapport_x_gradM4_M_other_prey_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_M_other_prey_sel -2*laplacien_M4_M




### For predator in response to caribou
## Definition du coefficient d'advection
scalaire p4 2
scalaire mult_p4 -2 * coeff_diffusion_P_norm

### Initialisation
scallin averaged_PC_cont 0 
scalaire M4_P p4 * P_caribou_dens * averaged_PC_cont 


## Calcul du gradient du coefficient d'advection
#gradient grad_p4 p4

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM4_P M4_P

## Calcul du Laplacien de P4_C
### En x 
gradient der_sec_par_rapport_x_gradM4_P_caribou_sel gradM4_PX

### En y 
gradient der_sec_par_rapport_y_gradM4_P_caribou_sel gradM4_PY

### Calcul du Laplacien
scalaire laplacien_M4_P der_sec_par_rapport_x_gradM4_P_caribou_selX + der_sec_par_rapport_x_gradM4_P_caribou_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_P_caribou_sel -2*laplacien_M4_P



### For predator in response to moose
## Definition du coefficient d'advection
scalaire p5 1

## TODO: a estimer from litterature
scalaire P_moose_dens 0

### Initialisation
scallin averaged_PM_cont 0 
scalaire M5_P p5 * P_moose_dens * averaged_PM_cont 

scalaire mult_p5 -2*coeff_diffusion_P_norm

## Calcul du gradient du coefficient d'advection
gradient grad_p5 p5

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM5_P M5_P

## Calcul du Laplacien de P5_M
### En x 
gradient der_sec_par_rapport_x_gradM5_P_moose_sel gradM5_PX

### En y 
gradient der_sec_par_rapport_y_gradM5_P_moose_sel gradM5_PY

### Calcul du Laplacien
scalaire laplacien_M5_P der_sec_par_rapport_x_gradM5_P_moose_selX + der_sec_par_rapport_x_gradM5_P_moose_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_P_moose_sel -2*laplacien_M5_P



# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- M5  - Predator                               -------------------------------------------------------------------


### For caribou
## Definition du coefficient d'advection

## Puisqu'on definit le terme de cross diffusion comme "- 2 blablabla", alors il faut faire attention au signe de c5 
## Si c5 positif: repulsion pour P
scalaire c5 3

## Si c5 negatif: attraction pour P
#scalaire c5 -1

scalaire mult_c5 -2* coeff_diffusion_C_norm

#TODO: checker si le fait que beta soit positif pour ce mecanismes a du sens? 
### Initialisation
scallin averaged_CP_cont 0 
scalaire M5_C c5 * C_wolf_dens * averaged_CP_cont 


## Test ponderation M5
#scalaire mult_c5 -20* coeff_diffusion_C_norm

## Calcul du gradient du coefficient d'advection
#gradient grad_c5 c5

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM5_C M5_C

## Calcul du Laplacien de M5_C
### En x 
gradient der_sec_par_rapport_x_gradM5_C_pred_sel gradM5_CX

### En y 
gradient der_sec_par_rapport_y_gradM5_C_pred_sel gradM5_CY

### Calcul du Laplacien
scalaire laplacien_M5_C der_sec_par_rapport_x_gradM5_C_pred_selX + der_sec_par_rapport_x_gradM5_C_pred_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_C_pred_sel -2*laplacien_M5_C


### For moose

# TODO: we here don't define the term for the reaction to predation, because we don't have the beta coefficient - what to do then????
# Trouvable dans Latombe2014, c'est son coefficient diffPref: 1.21 en hiver et 0.65 en été
scalaire M_wolf_dens 0.93

scalaire m5 1
scalaire mult_m5 -2*coeff_diffusion_M_norm

### Initialisation
scallin averaged_MP_cont 0 
scalaire M5_M m5 * M_wolf_dens * averaged_MP_cont


gradient gradM5_M M5_M

# Calcul du Laplacien de M5_M
### En x 
gradient der_sec_par_rapport_x_gradM5_M_pred_sel gradM5_MX

### En y 
gradient der_sec_par_rapport_y_gradM5_M_pred_sel gradM5_MY

### Calcul du Laplacien
scalaire laplacien_M5_M der_sec_par_rapport_x_gradM5_M_pred_selX + der_sec_par_rapport_x_gradM5_M_pred_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_M_pred_sel -2*laplacien_M5_M



# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- M6  - Invasive prey species                            -------------------------------------------------------------------

## WTD - Northward invasion of the species
## On définit un vecteur en 3D qui va transporter H3 selon l'axe des y (vers le nord)
#scalaire advection_coeff 1 
#scalaire scalTD1 1e-3
#empilementto2 TD1 [Zero, scalTD1, Zero, Zero, Zero, Zero]


## Lorsque l'advection est constante dans le temps, on peut definir le coefficient d'advection par un vecteur 
## Valeur empirique de la vitesse d'invasion de D (km/year)
scalaire travel_speed_D1 3.33 
## Coefficient d'advection, utilise pour ponderer la force du mecanisme par rapport aux autres
scalaire coef_advection_D1 1
## Direction d'advection
scalaire scalTD1 1

## Selon ce qu'on veut, advection verticale ou horizontale
vectoriel3D TD1 [0, travel_speed_D1, 0]


### For caribou
## Definition du coefficient d'advection
#scalaire c6 1
#scalaire C_WTD_dens -1

### Initialisation
scallin averaged_CD_cont 0 

#scalaire M6_C c6 * C_WTD_dens * averaged_CD_cont

#scalaire mult_c6 -2*coeff_diffusion_C_norm

## Calcul du gradient du coefficient d'advection
#gradient grad_c6 c6

## Calcul du gradient de ressources basé sur la diversité de l'habitat
#gradient gradM6_C M6_C

## Calcul du Laplacien de M6_C
### En x 
#gradient der_sec_par_rapport_x_gradM6_C_WTD_sel gradM6_CX

### En y 
#gradient der_sec_par_rapport_y_gradM6_C_WTD_sel gradM6_CY

### Calcul du Laplacien
#scalaire laplacien_M6_C der_sec_par_rapport_x_gradM6_C_WTD_selX + der_sec_par_rapport_y_gradM6_C_WTD_selY

### Formulation du terme de masse de l'advection
#scalaire terme_masse_adv_C_WTD_sel -2*laplacien_M6_C

### Initialisation
scallin averaged_MD_cont 0 

#==========================================================================================================================================================================
#==========================================================================================================================================================================

# ================================================= 2. PREPARATION DES EQUATIONS POUR RESOLUTION                                               ============================




#==========================================================================================================================================================================
# ================================================= 2.2 Definition d'un probleme element fini pour MEF  ===================================================================

# Création d'un ProblemeEF pour accueillir TFs, PPs, CLs, Exportations:
# ici on nomme notre problème probDida :
# TODO: a changer
problemeef probDida

# Création d'exportations attachées à probDida:
{ exportation            probDida
  format_exportation     GIREF
  format_exportation     VTK
  degre_interpolation LIN

  # On ajoute les champs qu'on veut retrouver en sortie, visibles dans Paraview
  ajoute_champ            coeff_diffusion_P_norm
  ajoute_champ            scalDP
  ajoute_champ            valeurs_paysage
  ajoute_champ            valeurs_diversity
  ajoute_champ            averaged_CM
  ajoute_champ            M_reinterpol
  ajoute_champ            rayon_perception_M_norm
  ajoute_champ            alg_rayon_perception_C_norm
  ajoute_champ            rayon_perception_C_norm
  ajoute_champ            gradM4_C
  ajoute_champ            laplacien_M4_C
  ajoute_champ            gradM1_C
  ajoute_champ            gradM4_P 
  ajoute_champ            M4_C 
  ajoute_champ            M1_C 
  ajoute_champ            laplacien_M4_P
  ajoute_champ            averaged_PC



  ## Pour aussi exporter les entités (pour visualiser les contours des obstacles, par ex)
  ajoute_entites_geo_en_champs true


  # Nom des fichiers de sorties. Important: pour exécuter le code, il faut supprimer la partie
  # $CheminAccesExport$/ (utile seulement pour les tests de validation) :
  # TODO: a changer
  prefixe_sorties $CheminAccesExport$/simulations/newfolder


}





#==========================================================================================================================================================================
# ================================================= 2.3 Definition des Pré et Post PostTraitements      ===================================================================

# On définit ici les fonctions (~actions), qui seront roulées en court de résolution des PDE. On décide ensuite l'ordre de leur execution a la fin du script. 

# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.3.1 Exportation des résultats                     -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

pp_exportation                      pp_exportInitial               [probDida, "$CheminAccesExport$/simulations/SolutionInitiale/expo_init_", 4, true]

pp_exportation                      exports_finaux                 [probDida, "$CheminAccesExport$/simulations/resultats_distrib_initial_", 4, true]


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.3.2 Moyennage locaux self                 -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### Normalisation du rayon
## La syntaxe du pp_reinterpole est: [champ_destination, champ_source]
## Ici, on applique une expression algébrique pour normaliser le rayon par rapport a la taille du paysage (entree) et on store la valeur obtenue
## dans un scalaire "rayon_perception_X_norm"
## La reinterpolation est necessaire pour passer du resultat d'une exp_alg a un scalaire ChampScalAConstant: le scalaire obtenu
## est ensuite utilise comme rayon de convolution

pp_reinterpole                      pp_reinterpole_rayon_norm_C        [rayon_perception_C_norm, alg_rayon_perception_C_norm]
pp_reinterpole                      pp_reinterpole_rayon_norm_M        [rayon_perception_M_norm, alg_rayon_perception_M_norm]
pp_reinterpole                      pp_reinterpole_rayon_norm_P        [rayon_perception_P_norm, alg_rayon_perception_P_norm]
pp_reinterpole                      pp_reinterpole_rayon_norm_D        [rayon_perception_D_norm, alg_rayon_perception_D_norm]


### Reinterpolation des champs des especes car il faut un ChampScalConstElem pour que le pp_filtrage_moyenne fonctionne
## A pour effet de passer un champ de continu a discret
pp_reinterpole                      pp_reinterpole_C                    [C_reinterpol, C]
pp_reinterpole                      pp_reinterpole_M                    [M_reinterpol, M]
pp_reinterpole                      pp_reinterpole_P                    [P_reinterpol, P]
pp_reinterpole                      pp_reinterpole_D                    [D_reinterpol, D1]


### Application du pp_filtrage_moyenne
## La syntaxe du pp_filtrage_moyenne est: [champ_source, champ_destination, rayon d'action]
pp_filtrage_moyenne                 pp_moyenne_locale_CC                [C_reinterpol, averaged_CC, rayon_perception_C_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_MM                [M_reinterpol, averaged_MM, rayon_perception_M_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_PP                [P_reinterpol, averaged_PP, rayon_perception_P_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_DD                [D_reinterpol, averaged_DD, rayon_perception_D_norm]


## Projection L2 pour convertir discret en continu
pp_projection_l2        projection_l2_CC   [averaged_CC, averaged_CC_cont, schema_intg]
pp_projection_l2        projection_l2_MM   [averaged_MM, averaged_MM_cont, schema_intg]
pp_projection_l2        projection_l2_PP   [averaged_PP, averaged_PP_cont, schema_intg]
pp_projection_l2        projection_l2_DD   [averaged_DD, averaged_DD_cont, schema_intg]




# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.3.2 Moyennage locaux not-self                     -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

## TEST avec petit paysage
#pp_filtrage_moyenne                 pp_moyenne_locale_CM            [M_reinterpol, averaged_CM, 0.05]
pp_filtrage_moyenne                 pp_moyenne_locale_CM            [M_reinterpol, averaged_CM, rayon_perception_C_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_CP            [P_reinterpol, averaged_CP, rayon_perception_C_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_CD            [D_reinterpol, averaged_CD, rayon_perception_C_norm]


pp_filtrage_moyenne                 pp_moyenne_locale_MC            [C_reinterpol, averaged_MC, rayon_perception_M_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_MP            [P_reinterpol, averaged_MP, rayon_perception_M_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_MD            [D_reinterpol, averaged_MD, rayon_perception_M_norm]


pp_filtrage_moyenne                 pp_moyenne_locale_PC            [C_reinterpol, averaged_PC, 0.05]
pp_filtrage_moyenne                 pp_moyenne_locale_PM            [M_reinterpol, averaged_PM, rayon_perception_P_norm]
pp_filtrage_moyenne                 pp_moyenne_locale_PD            [D_reinterpol, averaged_PD, rayon_perception_P_norm]



pp_projection_l2        projection_l2_CM   [averaged_CM, averaged_CM_cont, schema_intg]
pp_projection_l2        projection_l2_CP   [averaged_CP, averaged_CP_cont, schema_intg]
pp_projection_l2        projection_l2_CD   [averaged_CD, averaged_CD_cont, schema_intg]

pp_projection_l2        projection_l2_MC   [averaged_MC, averaged_MC_cont, schema_intg]
pp_projection_l2        projection_l2_MP   [averaged_MP, averaged_MP_cont, schema_intg]
pp_projection_l2        projection_l2_MD   [averaged_MD, averaged_MD_cont, schema_intg]


pp_projection_l2        projection_l2_PC   [averaged_PC, averaged_PC_cont, schema_intg]


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.3.3 Normalisation des scores G de parcelles       -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------


#==========================================================================================================================================================================
# ================================================= 2.4 Définition des termes de formulation (TF)                                       ===================================

## On définit ici tous les termes de formulation (faits en partie avec eMEF), permettant de décrire chaque morceau des équations


{ probDida


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.4.3 TF de C                                      -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------


  ### ----------------------------- Termes de diffusion 
  ## on veut resoudre l'equation de la diffusion seulement dans le domaine qui n'est pas l'obstacle (sous-domaine)
  #tfdiffusion                    tfDiffusionC                                   [champgeo, C, C, DC, schema_intg, defaut::sous_domaine]
  tfdiffusion                    tfDiffusionC                                  [champgeo, C, C, DC, schema_intg]


  scalaire petit_diff 1e-3
  empilementto2 no_diff_C    [petit_diff,petit_diff,petit_diff, Zero, Zero, Zero]

  #tfdiffusion                    tfDiffusionC                                  [champgeo,  C, C, no_diff_C, schema_intg]


  

  ### ----------------------------- Termes cross-diffusion
  ## Selection d'habitat: M1
  #tftransportconvectifscalaire   transportM1_C                                 [champgeo, C, C, gradM1_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M1_C                          [champgeo, C, C, terme_masse_adv_C_hab_sel, schema_intg]


  ## Test ecriture de terme de diffusion condensé
  #formulation_diffusion_source_inst         transportM1_C                      [schema_intg,(C, DC, mult_c, gradM1_C)]


  ## Selection d'habitat: M2
  #tftransportconvectifscalaire   transportM2_C                                 [champgeo, C, C, gradM2_C, mult_c2, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M2_C                          [champgeo, C, C, terme_masse_adv_C_div_sel, schema_intg]


  ## Presence de congeneres (local average): M3
  ## Sc1 - moyenne de C
  #tftransportconvectifscalaire   transportM3_C                                  [champgeo, C, C, gradM3_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M3_C                           [champgeo, C, C, terme_masse_adv_C_cons_sel, schema_intg]

  ## Presence autre espece de proie (local average): M4
  #tftransportconvectifscalaire   transportM4_C                                 [champgeo, C, C, gradM4_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M4_C                          [champgeo, C, C, terme_masse_adv_C_other_prey_sel, schema_intg]

  ## Presence predateur (local average): M5
  #tftransportconvectifscalaire   transportM5_C                                 [champgeo, C, C, gradM5_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M5_C                          [champgeo, C, C, terme_masse_adv_C_pred_sel, schema_intg]


  ### ----------------------------- Termes de reaction
  
  #tfmassegenscal                 tfCroissanceC                                 [champgeo, C, C, coeffCroissance_C, schema_intg]
  #tfmassegenscal                 tfDensiteDepC                                 [champgeo, C, C, coeffDensiteDepC, schema_intg]
  #tfmassegenscal                 tfPredationCP                                 [champgeo, C, C, coeffPredationCP, schema_intg]




# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 2.4.3 TF de M                                      -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  ### ----------------------------- Termes de diffusion 
  #tfdiffusion                    tfDiffusionM                                [champgeo, M, M, DM, schema_intg]

  empilementto2 no_diff_M    [petit_diff,petit_diff,petit_diff, Zero, Zero, Zero]

  tfdiffusion                    tfDiffusionM                                   [champgeo, M, M, no_diff_M, schema_intg]

  ### ----------------------------- Termes de cross-diffusion 

  #### M1 - Habitat selection
