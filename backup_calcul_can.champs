### b. Raster de heterogeneité (col4)


## Ce code appelle la conversion d'un .csv en entrée vers un .mail, et il cree aussi un cmefpp par colonne supplementaire dans le .csv originel
## Commenté quand on utilise le grand paysage car doit être convertit en binaire
include conversion_csv_mail.champs

## Ici, on importe les metadonnes liees au .csv du paysage: Vraie longueur et largeur en km (length_landscape)

### !!!!!!!!!! A changer en fonction du paysage !!!!!!!!!!
include metadata_landscape.champs

#maillage_a_partir_geo carreRachel [rectangle, 2, Lin]


#==========================================================================================================================================================================
# ================================================= 2.1 Definition du schema d'integration              ===================================================================

# Paramètres qui serviront à créer un schéma d'intégration. Plus il y a de points, et plus la solution est
# exacte. Il faut respecter certains critères lorsqu'on met des points (seulement certaines valeurs)
# fonctionnent dépendamment du type d'élément:
{ ParamSchema
  scalaire ptintgarete               3
  scalaire ptintgface3               3
  scalaire ptintgface4               2
  scalaire ptintgelement1d           3
  scalaire ptintgtriangle            16
  scalaire ptintgquadrangle          2
  scalaire ptintgtetra               5
  scalaire ptintgprismetri_legendre  2
  scalaire ptintgprismetri_triangle  3
  scalaire ptintghexa                2
}

# Création d'un schéma d'intégration selon les paramètres du "namespace" ParamSchema
schemaintg schema_intg ParamSchema




# ================================================= X.X Definition entite geométriques du domaine  =================================================================
## La creation du maillage n'entraine pas la creation des entités, alors on fait ca nous meme
# On peut aussi faire des operations sur les entites du maillage pour ne recuperer que les bords


# ------------------------------------------------------------------
## Definition des entites (contours) du paysage
# BAS
scalaire fct_critere_bas if(y=0, 1, 0)
critere_fct_caracteristique critere_bas [fct_critere_bas, 0]
cree_entite_avec_critere bas  ENTITE_TOUTES_COMPOSANTES(critere_bas)

# HAUT
scalaire fct_critere_haut if(y=1, 1, 0)
critere_fct_caracteristique critere_haut [fct_critere_haut, 0]
cree_entite_avec_critere haut  ENTITE_TOUTES_COMPOSANTES(critere_haut)

# GAUCHE
scalaire fct_critere_gauche if(x=0, 1, 0)
critere_fct_caracteristique critere_gauche [fct_critere_gauche, 0]
cree_entite_avec_critere gauche  ENTITE_TOUTES_COMPOSANTES(critere_gauche)

# DROITE
scalaire fct_critere_droite if(x=1, 1, 0)
critere_fct_caracteristique critere_droite [fct_critere_droite, 0]
cree_entite_avec_critere droite  ENTITE_TOUTES_COMPOSANTES(critere_droite)
# ------------------------------------------------------------------


## Definition domaine entier (interieur)
scalaire fct_bornes_domaine if(x>=0 & x <=1 & y>= 0 & y<= 1, 1, 0)
critere_fct_caracteristique critere_bornes_domaine [fct_bornes_domaine, 0]
cree_entite_avec_critere contour_domaine  ENTITE_TOUTES_COMPOSANTES(critere_bornes_domaine)


# ------------------------------------------------------------------

## Definition de positions "classiques" pour l'initialisation des distribution des especes
scalaire top_right     ((x - 1)^2 + (y - 1)^2)
scalaire top_left      ((x)^2 + (y - 1 )^2)
scalaire left_middle   ((x)^2 + (y - 0.5 )^2)
scalaire top_center    ((x-0.5)^2 + (y - 1 )^2)
scalaire bottom_right  ((x-1)^2+(y)^2)
scalaire bottom_left   ((x)^2+(y)^2)
scalaire center        ((x-0.5)^2+(y-0.5)^2)
scalaire left_center   ((x-0.2)^2+(y-0.5)^2)
scalaire right_center   ((x-0.6)^2+(y-0.4)^2)
scalaire bottom_center ((x-0.5)^2+(y)^2)
scalaire almost_bottom_center ((x-0.5)^2+(y+0.1)^2)
scalaire custom_M        ((x-0.7)^2+(y-0.4)^2)




# Si on fait maillage sur sommets:
## on recupere ici chacune des colonnes du .csv 
scallin valeurs_paysage "carreRachel.habitat.cmefpp" 
scallin valeurs_diversity "carreRachel.diversity.cmefpp" 
#scallin sum_caribou "carreRachel.sum_caribou.cmefpp" 
#scallin sum_moose "carreRachel.sum_moose.cmefpp" 
#scallin sum_wolf "carreRachel.sum_wolf.cmefpp" 


# Si on fait maillage sur barycentress
#scalconstelem valeurs_paysage "carreRachel.category.cmefpp" 


# ================================================= 0.2 Distributions initiales                         ===================================================================


## Valeur max de la gaussienne (pas exactement...)
scalaire densiteInitC   10
scalaire densiteInitM   10
scalaire densiteInitP   0
scalaire densiteInitD1  0

## Definition de l'etalement des cloches de distribution intiale
## Lorsque cette valeur est grande: cloche super etroite
## Lorsque cette valeur est petite: cloche full etalée 

scalaire etalementCloche 1e3

## Definition de la distribution initiale dans l'espace
scalquad C    densiteInitC*exp( (-300*center) ) + densiteInitC*exp( (-300*top_right) ) + densiteInitC*exp( (-300*bottom_left) )
scalquad M    densiteInitM*exp( (-25*custom_M) ) 
#scalquad M    densiteInitM/2*exp( (-etalementCloche*center) ) + densiteInitM/2*exp( (-etalementCloche*bottom_left) )
scalquad P    densiteInitP*exp( (-25*top_left) )  + densiteInitP*exp( (-25*bottom_right) ) 
scalquad D1   densiteInitD1*exp( (-etalementCloche*top_right) )



# ================================================= 0.3 Charge les coefficients de selection qui viennent des iSSA ========================================================

### For caribou
include beta_Boreal_Caribou_habitat_selection_coefficients.champs
include beta_Boreal_Caribou_diversity_selection_coefficients.champs
include beta_Boreal_Caribou_conspecific_selection_coefficients.champs
include beta_Boreal_Caribou_moose_selection_coefficients.champs
include beta_Boreal_Caribou_wolf_selection_coefficients.champs

### For moose
include beta_Moose_habitat_selection_coefficients.champs
include beta_Moose_diversity_selection_coefficients.champs
include beta_Moose_conspecific_selection_coefficients.champs
include beta_Moose_other_prey_selection_coefficients.champs

### For wolf
include beta_Gray_Wolf_habitat_selection_coefficients.champs
include beta_Gray_Wolf_diversity_selection_coefficients.champs
include beta_Gray_Wolf_conspecific_selection_coefficients.champs
include beta_Gray_Wolf_caribou_selection_coefficients.champs



# ================================================= 0.4 Découpe le paysage en binaires en fct du type d'habitat     ========================================================


## Type d'habitat
## Pour chaque type d'habitat, on definit un champs qui prendra la valeur 1 lorsque le pixel sera de ce type d'habitat, et 0 sinon
scallin Z1 if(valeurs_paysage == 1, 1, 0)
scallin Z2 if(valeurs_paysage == 2, 1, 0) 
scallin Z3 if(valeurs_paysage == 3, 1, 0) 
scallin Z4 if(valeurs_paysage == 4, 1, 0) 
scallin Z5 if(valeurs_paysage == 5, 1, 0) 
scallin Z6 if(valeurs_paysage == 6, 1, 0) 
scallin Z7 if(valeurs_paysage == 7, 1, 0) 
scallin Z8 if(valeurs_paysage == 8, 1, 0) 
scallin Z9 if(valeurs_paysage == 9, 1, 0) 
scallin Z10 if(valeurs_paysage == 10, 1, 0) 
scallin Z11 if(valeurs_paysage == 11, 1, 0) 
scallin Z12 if(valeurs_paysage == 12, 1, 0) 


## Heterogeneité
scallin Y1 if(valeurs_diversity == 1, 1, 0)
scallin Y2 if(valeurs_diversity == 2, 1, 0) 
scallin Y3 if(valeurs_diversity == 3, 1, 0) 
scallin Y4 if(valeurs_diversity == 4, 1, 0) 
scallin Y5 if(valeurs_diversity == 5, 1, 0) 
scallin Y6 if(valeurs_diversity == 6, 1, 0) 



## M7
## Les valeurs de lambda sont chargees a partir du fichier "coefficient.champs" car les valeurs
## dependent de si on est en M0 ou en M7


#scalaire scalDC if(valeurs_paysage == 1, exp(lambda_1), if(valeurs_paysage == 2, exp(lambda_2), if(valeurs_paysage == 3, exp(lambda_3), if(valeurs_paysage == 4, exp(lambda_4), if(valeurs_paysage == 5, exp(lambda_5), if(valeurs_paysage == 6, exp(lambda_6), if(valeurs_paysage == 7, exp(lambda_7), if(valeurs_paysage == 8, exp(lambda_8), if(valeurs_paysage == 9, exp(lambda_9), if(valeurs_paysage == 10, exp(lambda_10), if(valeurs_paysage == 11, exp(lambda_11), exp(lambda_12))))))))))))



# ================================================= 0.5 Test pour les landscape features, définition d'obstacles     ========================================================

## On definit les coordonnees de l'obstacle
scalaire    obstacle_x_min    0
scalaire    obstacle_x_max    0
scalaire    obstacle_y_min    0
scalaire    obstacle_y_max    0


# ------------------------------------------------------------------
## Definition des entites (contours) de l'obstacle

# BAS
scalaire                    fct_obstacle_bas      if(y=obstacle_y_min & x>=obstacle_x_min & x<=obstacle_x_max, 1, 0)
critere_fct_caracteristique obstacle_bas          [fct_obstacle_bas, 0]
cree_entite_avec_critere    bas_obstacle          ENTITE_TOUTES_COMPOSANTES(obstacle_bas)

# HAUT
scalaire                    fct_obstacle_haut     if(y=obstacle_y_max & x>=obstacle_x_min & x<=obstacle_x_max, 1, 0)
critere_fct_caracteristique obstacle_haut         [fct_obstacle_haut, 0]
cree_entite_avec_critere    haut_obstacle         ENTITE_TOUTES_COMPOSANTES(obstacle_haut)

# GAUCHE
scalaire                    fct_obstacle_gauche   if(x=obstacle_x_min & y>=obstacle_y_min & y<=obstacle_y_max, 1, 0)
critere_fct_caracteristique obstacle_gauche       [fct_obstacle_gauche, 0]
cree_entite_avec_critere    gauche_obstacle       ENTITE_TOUTES_COMPOSANTES(obstacle_gauche)

# DROITE
scalaire                    fct_obstacle_droite   if(x=obstacle_x_max & y>=obstacle_y_min & y<=obstacle_y_max, 1, 0)
critere_fct_caracteristique obstacle_droite       [fct_obstacle_droite, 0]
cree_entite_avec_critere    droite_obstacle       ENTITE_TOUTES_COMPOSANTES(obstacle_droite)


# ------------------------------------------------------------------
# Definition de l'obstacle entier (interieur)

scalaire fct_obstacle if(x>=obstacle_x_min & x<=obstacle_x_max & y>=obstacle_y_min & y<=obstacle_y_max, 1, 0)
critere_fct_caracteristique fct_car_obstacle [fct_obstacle, 0]
cree_entite_avec_critere obstacle  ENTITE_TOUTES_COMPOSANTES(fct_car_obstacle)

# ------------------------------------------------------------------

## Nouveau domaine sur lequel on va résoudre les équations: domaine entier - l'obstacle

cree_entite sous_domaine contour_domaine - obstacle

cree_entite sous_domaine_intersection contour_domaine ^ obstacle



#==========================================================================================================================================================================
#==========================================================================================================================================================================


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
###########            REACTION
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

include terme_croissance.champs

#==========================================================================================================================================================================
#==========================================================================================================================================================================


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 1.3.2 Diffusion simple                              -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

## Importe les valeurs des coefficients de diffusion
include diffusion_parms.champs


## Coefficients de diffusion adimensionnel
scalaire coeff_diffusion_C_norm   1


## Adimensionnalisation du coefficient de diffusion
#scalaire "coeff_diffusion_C_norm" f(scalDC, L)=scalDC/L^2
scalaire "coeff_diffusion_M_norm" f(scalDC, scalDM)=scalDM/scalDC
scalaire "coeff_diffusion_P_norm" f(scalDC, scalDP)=scalDP/scalDC
scalaire "coeff_diffusion_D_norm" f(scalDC, scalDD1)=scalDD1/scalDC


## Creation des tenseurs 3D
## C'est une matrice symetrique en 2D 3x3, qui a pour valeurs sur la diagonale les 3 premieres valeurs du tenseur, et en autres valeurs les 3 derniers termes du tenseur.
empilementto2 DC    [coeff_diffusion_C_norm, coeff_diffusion_C_norm, coeff_diffusion_C_norm, Zero, Zero, Zero]
empilementto2 DM    [coeff_diffusion_M_norm, coeff_diffusion_M_norm, coeff_diffusion_M_norm, Zero, Zero, Zero]
empilementto2 DP    [coeff_diffusion_P_norm, coeff_diffusion_P_norm, coeff_diffusion_P_norm, Zero, Zero, Zero]
empilementto2 DD1   [coeff_diffusion_D_norm, coeff_diffusion_D_norm, coeff_diffusion_D_norm, Zero, Zero, Zero]





# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- 1.3.3 Cross-diffusion                               -------------------------------------------------------------------
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

# ------------------------------------------------- M1  - Habitat selection                               -------------------------------------------------------------------


### For caribou
## Set landcover3 preference to 0 becauser this layer was used as the reference for iSSA
scalaire C_landcover3 0

## Definition du coefficient d'advection
scalaire c1 3
scalaire mult_c -2 * coeff_diffusion_C_norm

scalquad M1_C c1 * (C_landcover1 * Z1 + C_landcover2 * Z2 + C_landcover3 * Z3 + C_landcover4 * Z4 + C_landcover5 * Z5 + C_landcover6 * Z6 + C_landcover7 * Z7 + C_landcover8 * Z8 + C_landcover9 * Z9 + C_landcover11 * Z11 + C_landcover12 * Z12  ) 

## Calcul du gradient du coefficient d'advection
#gradient grad_c1 c1

## Calcul du gradient de ressources basé sur le type d'habitat
gradient gradM1_C M1_C

## Calcul du Laplacien de M1_C
### En x 
gradient der_sec_par_rapport_x_gradM1_C_hab_sel gradM1_CX

### En y 
gradient der_sec_par_rapport_y_gradM1_C_hab_sel gradM1_CY

### Calcul du Laplacien
scalaire laplacien_M1_C der_sec_par_rapport_x_gradM1_C_hab_selX + der_sec_par_rapport_y_gradM1_C_hab_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_C_hab_sel -2*laplacien_M1_C


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For moose
## Set landcover7 preference to 0 becauser this layer was used as the reference for iSSA
scalaire M_landcover7 0

## Definition du coefficient d'advection
scalaire m1 1
scalaire mult_m1 -2 * coeff_diffusion_M_norm


scalquad M1_M m1 * (M_landcover1 * Z1 + M_landcover2 * Z2 + M_landcover3 * Z3 + M_landcover4 * Z4 + M_landcover5 * Z5 + M_landcover6 * Z6 + M_landcover7 * Z7 + M_landcover8 * Z8 + M_landcover9 * Z9 + M_landcover11 * Z11 + M_landcover12 * Z12  ) 

## Calcul du gradient du coefficient d'advection
gradient grad_m1 m1

## Calcul du gradient de ressources basé sur le type d'habitat
gradient gradM1_M M1_M

## Calcul du Laplacien de M1_M
### En x 
gradient der_sec_par_rapport_x_gradM1_M_hab_sel gradM1_MX

### En y 
gradient der_sec_par_rapport_y_gradM1_M_hab_sel gradM1_MY

### Calcul du Laplacien
scalaire laplacien_M1_M der_sec_par_rapport_x_gradM1_M_hab_selX + der_sec_par_rapport_y_gradM1_M_hab_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_M_hab_sel -2*laplacien_M1_M



# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For WTD
## See if we take the values of the moose for this? Or seek in the literature?

scalaire D1_landcover3 0
scalaire d1 1
scalaire mult_d1 -2 * coeff_diffusion_M_norm
#scalquad M1_D1 d1 * (D1_landcover1 * Z1 + D1_landcover2 * Z2 + D1_landcover3 * Z3 + D1_landcover4 * Z4 + D1_landcover5 * Z5 + D1_landcover6 * Z6 + D1_landcover7 * Z7 + M_landcover8 * Z8 + M_landcover9 * Z9 + M_landcover11 * Z11 + M_landcover12 * Z12  ) 


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For predator
## Set landcover7 preference to 0 becauser this layer was used as the reference for iSSA
scalaire P_landcover7 0

## Definition du coefficient d'advection
scalaire p1 1
scalaire mult_p1 -2* coeff_diffusion_P_norm

scalquad M1_P p1 * (P_landcover1 * Z1 + P_landcover2 * Z2 + P_landcover3 * Z3 + P_landcover4 * Z4 + P_landcover5 * Z5 + P_landcover6 * Z6 + P_landcover7 * Z7 + P_landcover8 * Z8 + P_landcover9 * Z9 + P_landcover11 * Z11 + P_landcover12 * Z12 ) 

## Calcul du gradient du coefficient d'advection
gradient grad_p1 p1

## Calcul du gradient de ressources basé sur le type d'habitat
gradient gradM1_P M1_P

## Calcul du Laplacien de M1_P
### En x 
gradient der_sec_par_rapport_x_gradM1_P_hab_sel gradM1_PX

### En y 
gradient der_sec_par_rapport_y_gradM1_P_hab_sel gradM1_PY

### Calcul du Laplacien
scalaire laplacien_M1_P der_sec_par_rapport_x_gradM1_P_hab_selX + der_sec_par_rapport_y_gradM1_P_hab_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_P_hab_sel -2*laplacien_M1_P


# ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------- M2  - Diversity selection                              -------------------------------------------------------------------


### For caribou
## Set C_diversity3 preference to 0 becauser this layer was used as the reference for iSSA
scalaire C_diversity3 0 

## Definition du coefficient d'advection
scalaire c2 3
scalaire M2_C c2 * (C_diversity1 * Y1 + C_diversity2 * Y2 + C_diversity3 * Y3 + C_diversity4 * Y4 + C_diversity5 * Y5 + C_diversity6 * Y6) 

scalaire mult_c2 -2* coeff_diffusion_C_norm

## Test ponderation M2
#scalaire mult_c2 -20* coeff_diffusion_C_norm

## Calcul du gradient du coefficient d'advection
gradient grad_c2 c2

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM2_C M2_C

## Calcul du Laplacien de M2_C
### En x 
gradient der_sec_par_rapport_x_gradM2_C_div_sel gradM2_CX

### En y 
gradient der_sec_par_rapport_y_gradM2_C_div_sel gradM2_CY

### Calcul du Laplacien
scalaire laplacien_M2_C der_sec_par_rapport_x_gradM2_C_div_selX + der_sec_par_rapport_y_gradM2_C_div_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_C_div_sel -2*laplacien_M2_C

# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For moose
## Set M_diversity3 preference to 0 becauser this layer was used as the reference for iSSA
scalaire M_diversity3 0 

## Definition du coefficient d'advection
scalaire m2 1
scalaire M2_M m2 * (M_diversity1 * Y1 + M_diversity2 * Y2 + M_diversity3 * Y3 + M_diversity4 * Y4 + M_diversity5 * Y5 + M_diversity6 * Y6) 

scalaire mult_m2 -2*coeff_diffusion_M_norm

## Calcul du gradient du coefficient d'advection
gradient grad_m2 m2

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM2_M M2_M

## Calcul du Laplacien de M2_C
### En x 
gradient der_sec_par_rapport_x_gradM2_M_div_sel gradM2_CX

### En y 
gradient der_sec_par_rapport_y_gradM2_M_div_sel gradM2_CY

### Calcul du Laplacien
scalaire laplacien_M2_M der_sec_par_rapport_x_gradM2_M_div_selX + der_sec_par_rapport_y_gradM2_M_div_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_M_div_sel -2*laplacien_M2_M


# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------

### For predator
## Set P_diversity3 preference to 0 becauser this layer was used as the reference for iSSA
scalaire P_diversity3 0 

## Definition du coefficient d'advection
scalaire p2 1
scalaire M2_P p2 * (P_diversity1 * Y1 + P_diversity2 * Y2 + P_diversity3 * Y3 + P_diversity4 * Y4 + P_diversity5 * Y5 + P_diversity6 * Y6) 

scalaire mult_p2 -2*coeff_diffusion_P_norm

## Calcul du gradient du coefficient d'advection
gradient grad_p2 p2

## Calcul du gradient de ressources basé sur la diversité de l'habitat
gradient gradM2_P M2_P

## Calcul du Laplacien de M2_P
### En x 
gradient der_sec_par_rapport_x_gradM2_P_div_sel gradM2_PX

### En y 
gradient der_sec_par_rapport_y_gradM2_P_div_sel gradM2_PY

### Calcul du Laplacien
scalaire laplacien_M2_P der_sec_par_rapport_x_gradM2_P_div_selX + der_sec_par_rapport_y_gradM2_P_div_selY

### Formulation du terme de masse de l'advection
scalaire terme_masse_adv_P_div_sel -2*laplacien_M2_P


