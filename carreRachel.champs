# ================================================= 2.6 Ajout des Pre-Post Traitements                                                  ===================================

## Le chemim dans lequel doivent être storés les résultats a chaque itération


{ probDida
  
#include active_pre_post_traitements.champs


## Pour exporter tous les pas de temps
#ajoutePrePostTraitement [pp_export, FinPasDeTemps]


## Ici on ajoute des PP pour vérifier si la perte de constance de masse vient des gradients enviro trop sharps? 

pp_reinterpole                      pp_reinterpole_M1_C                   [M1_C_reinterpol,      M1_C]
pp_filtrage_moyenne                 pp_moyenne_locale_M1_C                [M1_C_reinterpol,      avg_M1_C_disc,        rayon_perception_C_norm]
pp_projection_l2                    projection_l2_M1_C                    [avg_M1_C_disc,        avg_M1_C,             schema_intg]

pp_reinterpole                      pp_reinterpole_M2_C                   [M2_C_reinterpol,      M2_C]
pp_filtrage_moyenne                 pp_moyenne_locale_M2_C                [M2_C_reinterpol,      avg_M2_C_disc,        rayon_perception_C_norm]
pp_projection_l2                    projection_l2_M2_C                    [avg_M2_C_disc,        avg_M2_C,             schema_intg]

pp_reinterpole                      pp_reinterpole_M1_M                   [M1_M_reinterpol,      M1_M]
pp_filtrage_moyenne                 pp_moyenne_locale_M1_M                [M1_M_reinterpol,      avg_M1_M_disc,        rayon_perception_M_norm]
pp_projection_l2                    projection_l2_M1_M                    [avg_M1_M_disc,        avg_M1_M,             schema_intg]

pp_reinterpole                      pp_reinterpole_M2_M                   [M2_M_reinterpol,      M2_M]
pp_filtrage_moyenne                 pp_moyenne_locale_M2_M                [M2_M_reinterpol,      avg_M2_M_disc,        rayon_perception_M_norm]
pp_projection_l2                    projection_l2_M2_M                    [avg_M2_M_disc,        avg_M2_M,             schema_intg]

pp_reinterpole                      pp_reinterpole_M1_D                   [M1_D_reinterpol,      M1_D]
pp_filtrage_moyenne                 pp_moyenne_locale_M1_D                [M1_D_reinterpol,      avg_M1_D_disc,        rayon_perception_D_norm]
pp_projection_l2                    projection_l2_M1_D                    [avg_M1_D_disc,        avg_M1_D,             schema_intg]

pp_reinterpole                      pp_reinterpole_M2_D                   [M2_D_reinterpol,      M2_D]
pp_filtrage_moyenne                 pp_moyenne_locale_M2_D                [M2_D_reinterpol,      avg_M2_D_disc,        rayon_perception_D_norm]
pp_projection_l2                    projection_l2_M2_D                    [avg_M2_D_disc,        avg_M2_D,             schema_intg]




## Moyennage local du raster de vegetation et de diversité 

ajoutePrePostTraitement [pp_reinterpole_M1_C, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M1_C, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M1_C, AvantPremierPasTemps]


ajoutePrePostTraitement [pp_reinterpole_M2_C, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M2_C, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M2_C, AvantPremierPasTemps]

ajoutePrePostTraitement [pp_reinterpole_M1_M, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M1_M, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M1_M, AvantPremierPasTemps]


ajoutePrePostTraitement [pp_reinterpole_M2_M, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M2_M, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M2_M, AvantPremierPasTemps]

ajoutePrePostTraitement [pp_reinterpole_M1_D, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M1_D, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M1_D, AvantPremierPasTemps]


ajoutePrePostTraitement [pp_reinterpole_M2_D, AvantPremierPasTemps]
ajoutePrePostTraitement [pp_moyenne_locale_M2_D, AvantPremierPasTemps]
ajoutePrePostTraitement [projection_l2_M2_D, AvantPremierPasTemps]



}




