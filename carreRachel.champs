  ### ----------------------------- Termes de diffusion 
  #tfdiffusion                    tfDiffusionD1                                [champgeo, D1, D1, DD1, schema_intg]

  empilementto2 no_diff_D1    [petit_diff, petit_diff, petit_diff, Zero, Zero, Zero]

  #tfdiffusion                    tfDiffusionD1                                   [champgeo, D1, D1, no_diff_D1, schema_intg]


  ## ---------------------------- Termes de diffusion croisée

  ## Terme qui incorpore le gradient de l'ensemble des ressources i auxquels M est sensible, pondérés par les facteurs m_i
  #formulation_transport_diffusion_inst          transport_D1                  [schema_intg, grad_tot_D1, (D1, no_diff_D1, mult_d1)]
  

  ### ----------------------------- Termes d'advection 
  #tftransportconvectifscalaire   transportD1             [champgeo, D1, D1, TD1, coef_advection_D1, schema_intg, true]



}

#==========================================================================================================================================================================
#==========================================================================================================================================================================

#==========================================================================================================================================================================
# ================================================= 2.5 Définition conditions limites                                                   ===================================

  # Conditions aux limites. On écrit le type de condition, puis on indique l'entité sur laquelle  
  # se trouve la condition, puis la variable touchée par la condition (ici T pour température) et
  # finalement la condition. Il faut ajouter "schema_intg" après une condition autre que Dirichlet
  # (il y a une intégrale de bord à calculer):


#==========================================================================================================================================================================
# ================================================= 2.5 Définition conditions limites                                                   ===================================

  # Conditions aux limites. On écrit le type de condition, puis on indique l'entité sur laquelle  
  # se trouve la condition, puis la variable touchée par la condition (ici T pour température) et
  # finalement la condition. Il faut ajouter "schema_intg" après une condition autre que Dirichlet
  # (il y a une intégrale de bord à calculer):


{ probDida

# ------------------------------------ Frontieres de paysage ------------------------------------------------------------------------------------------------------------

## Neumann: impose une valeur a la derivee normale par rapport a l'entite ((ie caracterise le flux))


scalaire flux_P 0 


}





#==========================================================================================================================================================================
# ================================================= 2.7 Définition des conditions aux bords                                            ===================================


#==========================================================================================================================================================================
# ================================================= 2.8 Définition variables instationnaires pour résolution dans le temps              ===================================

{ probDida_inst
  #tfmassegenscal  tfDCdtMasse   [champgeo, C, C, Un, schema_intg, defaut::sous_domaine_cropped]
  tfmassegenscal  tfDCdtMasse   [champgeo, C, C, Un, schema_intg]
  #tfmassegenscal  tfDMdtMasse   [champgeo, M, M, Un, schema_intg]
  tfmassegenscal  tfDPdtMasse   [champgeo, P, P, Un, schema_intg]
  #tfmassegenscal  tfDD1dtMasse  [champgeo, D1, D1, Un, schema_intg]
}





## ================================================= Définition du solveur itératif PETc
## PETc
{options_prefixees_petsc options_slin

ksp_type fgmres
#ksp_gmres_preallocate
ksp_gmres_restart 50
ksp_gmres_modifiedgramschmidt 
ksp_monitor
ksp_atol 1e-20
ksp_rtol 1e-12

ksp_view

pc_type gamg


}

# Déclaration du solveur instationnaire:

# Il y a plusieurs schémas (gear, eulerimplicit, etc.) possibles. Ici, on choisit gear:
### solveur_inst_nlin Solveur_inst_0(probDida)

{ solveur_inst_nlin Solveur_inst(probDida)
   schema_temps gear
#   #schema_temps euler_implicite

  prefixe_options options_slin


   # Assignation des paramètres pour les résolutions non-linéaires. Cette propriété accepte deux
   # paramètres: le critère de convergence (réel) et le nombre maximum d'itérations (entier):
   #nombre_iterations_maximum        MaxItNlin
   criteres_convergence             [ToleranceNlin, MaxItNlin]
   #parametres_nlin [ToleranceNlin, MaxItNlin]

   # Les lignes suivantes indiquent au programme s'il devra, à chaque étape, recalculer
   # la matrice de masse ou rigidité. C'est nécessaire seulement quand elles dépendent du temps.
   # Deux choix: [f,f] : ne dépend pas du temps, ou [v,v]: dépend du temps.
   parametres_matrice_masse    [v,v]
   parametres_matrice_rigidite [v,v]

  # À noter: le solveur s'appelle dorénavant Solveur_inst(probDida)
}


## Definit le pp pour reinitialiser le solveur
pp_reinitialise_solveur pp_redemarre [Solveur_inst(probDida)]

{ exportation        export
  format_exportation GIREF
  format_exportation VTK
  ajoute_champ C
  ajoute_champ valeurs_paysage
  ajoute_champ valeurs_diversity
  ajoute_champ M
  ajoute_champ P
  ajoute_champ Phi_C
  ajoute_champ grad_Phi_C
  ajoute_eq_latex probDida
}


## Exporte dans le dossier simulations sous le nom NM_SM1 ou NM_SM2
#pp_exportation pp_export [export, "$CheminAccesExport$/simulations/vars_parms_c/CMP_", 2, true, true]
pp_exportation pp_export [export, "$CheminAccesExport$/simulations/Nelder_Mead/NM_SM1_", 2, true, true]


#==========================================================================================================================================================================
# ================================================= 2.6 Ajout des Pre-Post Traitements                                                  ===================================

## Le chemim dans lequel doivent être storés les résultats a chaque itération


{ probDida
  
include active_pre_post_traitements.champs


## Pour exporter tous les pas de temps
ajoutePrePostTraitement [pp_export, FinPasDeTemps]

}




#==========================================================================================================================================================================
#==========================================================================================================================================================================

# ================================================= 2.  RESOLUTION DES EQUATIONS                                                               ============================
## PP REBEL ##
#pp_resolution_probleme              resoud_Rachel                  [Solveur_inst(probDida)]


# A commenter si on roule sur Python, a decommenter si on roule sur MEF non local

## 
{ Actions
  pp_redemarre
  pp_export
  Solveur_inst(probDida)
  pp_export
}
