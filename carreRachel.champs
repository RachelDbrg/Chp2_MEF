# ================================================= 2.  RESOLUTION DES EQUATIONS                                                               ============================
## PP REBEL ##
#pp_resolution_probleme              resoud_Rachel                  [Solveur_inst(probDida)]




# A commenter si on roule sur Python, a decommenter si on roule sur MEF non local

## 
{ Actions
## reinitialise le solveur instationnaire
  pp_redemarre
## reinitialise les positions des especes entre chaque simulation
  pp_reinitialise_dens_init_C
  pp_reinitialise_dens_init_M
  pp_reinitialise_dens_init_P
  pp_reinitialise_dens_init_D
  pp_reinitialise_dens_init_C_bar
  pp_reinitialise_dens_init_M_bar
  pp_reinitialise_dens_init_P_bar
  pp_reinitialise_dens_init_D_bar
## Fait un premier export initial (import si frequence exportation ON)
  pp_export
## Resout boucle instationnaire
  Solveur_inst(probDida)
}
