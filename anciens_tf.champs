  ### ----------------------------- Termes de diffusion simple
  ## on veut resoudre l'equation de la diffusion seulement dans le domaine qui n'est pas l'obstacle (sous-domaine)
  #tfdiffusion                    tfDiffusionC                                   [champgeo, C, C, DC, schema_intg, defaut::sous_domaine_cropped]
  #tfdiffusion                    tfDiffusionC                                  [champgeo, C, C, DC, schema_intg]


  scalaire petit_diff 1e-1
  empilementto2 no_diff_C    [petit_diff,petit_diff,petit_diff, Zero, Zero, Zero]

  tfdiffusion                    tfDiffusionC                                  [champgeo,  C, C, no_diff_C, schema_intg, defaut::sous_domaine_cropped]
  #tfdiffusion                    tfDiffusionC                                  [champgeo,  C, C, no_diff_C, schema_intg]
  

  ### ----------------------------- Termes de diffusion croisée
  ## Selection d'habitat: M1
  #tftransportconvectifscalaire   transportM1_C                                 [champgeo, C, C, gradM1_C, mult_c, schema_intg, false, defaut::sous_domaine_cropped]
  #tfmassegenscal                 tftransport_bis_M1_C                          [champgeo, C, C, terme_masse_adv_C_hab_sel, schema_intg, defaut::sous_domaine_cropped]


  ## Selection d'habitat: M2
  #tftransportconvectifscalaire   transportM2_C                                 [champgeo, C, C, gradM2_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M2_C                          [champgeo, C, C, terme_masse_adv_C_div_sel, schema_intg]


  ## Presence de congeneres (local average): M3
  ## Sc1 - moyenne de C
  #tftransportconvectifscalaire   transportM3_C                                  [champgeo, C, C, gradM3_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M3_C                           [champgeo, C, C, terme_masse_adv_C_cons_sel, schema_intg]


  ## Presence autre espece de proie (local average): M4
  #tftransportconvectifscalaire   transportM4_C                                 [champgeo, C, C, gradM4_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M4_C                          [champgeo, C, C, terme_masse_adv_C_other_prey_sel, schema_intg]

  #formulation_transport_diffusion_source_inst   transportM4_C                   [schema_intg, gradM4_C, (C, DC, mult_c, terme_masse_adv_C_other_prey_sel)]

  ## Presence predateur (local average): M5
  #tftransportconvectifscalaire   transportM5_C                                 [champgeo, C, C, gradM5_C, mult_c, schema_intg, false]
  #tfmassegenscal                 tftransport_bis_M5_C                          [champgeo, C, C, terme_masse_adv_C_pred_sel, schema_intg]



