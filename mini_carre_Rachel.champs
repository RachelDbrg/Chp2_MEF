# ================================================= 2.8 Définition variables instationnaires pour résolution dans le temps              ===================================

{ probDida_inst
  #tfmassegenscal  tfDCdtMasse   [champgeo, C, C, Un, schema_intg, defaut::sous_domaine_cropped]
  tfmassegenscal  tfDCdtMasse   [champgeo, C, C, Un, schema_intg]
  tfmassegenscal  tfDMdtMasse   [champgeo, M, M, Un, schema_intg]
  tfmassegenscal  tfDPdtMasse   [champgeo, P, P, Un, schema_intg, defaut::sous_domaine_cropped]
  tfmassegenscal  tfDD1dtMasse  [champgeo, D1, D1, Un, schema_intg]
}


#==========================================================================================================================================================================
# ================================================= 2.9 Définition du solveur instationnaire                                            ===================================

# Liste d'informations utiles au solveur:
# Comprend le critère de convergence, le nombre d'itérations maximal ainsi que le temps initial.
#scalaire ToleranceNlin 1e-7
#scalaire ToleranceNlin 1e-1
#scalaire MaxItNlin 40

## Definition du temps initial
#scalaire t0 0

# Il y a plusieurs façon d'exprimer le solveur instationnai re. L'une d'elle est d'exprimer
# le nombre de pas de temps total voulu ainsi que la valeur de chaque pas.

## Definition du pas de temps
#scalaire delta_t 0.001

## Definition du nombre de pas de temps
#scalaire nombre_de_pas_de_temps 2

## Definition du temps final
#scalaire tf 3

include gestionnaire_pas_de_temps.champs


## ================================================= Définition du solveur itératif PETc
## PETc
{options_prefixees_petsc options_slin

ksp_type fgmres

ksp_gmres_restart 150
ksp_gmres_modifiedgramschmidt 
ksp_monitor
ksp_atol 1e-20
ksp_rtol 1e-12

ksp_view

pc_type gamg



}

# Déclaration du solveur instationnaire:

# Il y a plusieurs schémas (gear, eulerimplicit, etc.) possibles. Ici, on choisit gear:
# solveur_inst_nlin Solveur_inst_0(probDida)

{ solveur_inst_nlin Solveur_inst(probDida)
   schema_temps gear
#   #schema_temps euler_implicite

  prefixe_options options_slin


   # Assignation des paramètres pour les résolutions non-linéaires. Cette propriété accepte deux
   # paramètres: le critère de convergence (réel) et le nombre maximum d'itérations (entier):
   #nombre_iterations_maximum        MaxItNlin
   criteres_convergence             [ToleranceNlin, MaxItNlin]
   #parametres_nlin [ToleranceNlin, MaxItNlin]

   # Les lignes suivantes indiquent au programme s'il devra, à chaque étape, recalculer
   # la matrice de masse ou rigidité. C'est nécessaire seulement quand elles dépendent du temps.
   # Deux choix: [f,f] : ne dépend pas du temps, ou [v,v]: dépend du temps.
   parametres_matrice_masse    [v,v]
   parametres_matrice_rigidite [v,v]

  # À noter: le solveur s'appelle dorénavant Solveur_inst(probDida)
}


